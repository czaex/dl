{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "efn:red_thunder_ground",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "efn:thunder_ground"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 20,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_disc": {
				"radius": 0.5,
				"direction": ["math.sin(variable.particle_random_1*360)", "math.random(0,1)", "math.cos(variable.particle_random_1*360)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180,180)"
			},
			"minecraft:particle_initial_speed": "math.random(0.1,2)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 4
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.1, 0.1],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 1024,
					"texture_height": 125,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [128, 125],
						"step_UV": [128, 0],
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFF0000",
						"1.0": "#FF000000"
					}
				}
			}
		}
	}
}