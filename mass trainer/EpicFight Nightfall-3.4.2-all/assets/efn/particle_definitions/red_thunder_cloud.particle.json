{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "efn:red_thunder_cloud",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "efn:cloud"
			}
		},
		"curves": {
			"variable.radius": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0.93, 0.39, 0.18, 0.44]
			},
			"variable.shape": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0.05, 0.44, 0.77, 0.76, 0.45]
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 100,
				"max_particles": 200
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.sin(variable.particle_random_1*360)", 0, "math.cos(variable.particle_random_1*360)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 2
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,360)"
			},
			"minecraft:particle_initial_speed": "-math.random(1.5,2.5)",
			"minecraft:particle_motion_parametric": {
				"relative_position": ["math.sin(variable.particle_random_1*360+variable.particle_age*180)*1*variable.radius", "-variable.shape*math.clamp(variable.particle_random_2,0,0.5)", "math.cos(variable.particle_random_1*360+variable.particle_age*180)*1*variable.radius"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.2, 0.2],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 12,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FF40174D",
						"0.5": "#FF0E062F"
					}
				}
			}
		}
	}
}